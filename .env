# Universal Student API v2.0 - Environment Variables

# JWT Configuration
JWT_SECRET=universal-student-api-super-secret-key-2024-production-railway
JWT_EXPIRES_IN=24h

# Email Service Configuration
EMAIL_SERVICE=gmail
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-digit-app-password

# Alternative: SendGrid Configuration (uncomment if using SendGrid)
# EMAIL_SERVICE=sendgrid
# SENDGRID_API_KEY=your-sendgrid-api-key

# Generic SMTP Configuration (uncomment if using custom SMTP)
# EMAIL_SERVICE=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-password

# Email Settings
FROM_EMAIL=your-email@gmail.com
FRONTEND_URL=https://your-railway-url.railway.app

# Server Configuration
NODE_ENV=production

# Railway automatically provides PORT and other variables:
# PORT - Railway sets this automatically (usually 3000 or dynamic)
# RAILWAY_ENVIRONMENT=production (automatically set)